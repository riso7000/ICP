{
    "petri_net_name": "TOF_PN",
    "comment": "Timer to off, umí nastavit timeout a na požádání sdělit zbývající čas timeru.",
    "inputs": [
        "in",
        "set_to",
        "req_rt"
    ],
    "outputs": [
        "out",
        "rt"
    ],
    "variables": [
        "int timeout = 5000"
    ],
    "places": [
        {
            "place_name": "IDLE",
            "initial_tokens": 1,
            "pos_x": 100,
            "pos_y": 200
        },
        {
            "place_name": "ACTIVE",
            "initial_tokens": 0,
            "pos_x": 200,
            "pos_y": 100
        },
        {
            "place_name": "TIMING",
            "initial_tokens": 0,
            "pos_x": 250,
            "pos_y": 150
        }
    ],
    "transitions": [
        {
            "transition_name": "T_on",
            "pos_x": 150,
            "pos_y": 20,
            "in_transition": [
                {
                    "place_name": "IDLE",
                    "tokens": 1
                }
            ],
            "out_transition": [
                {
                    "place_name": "ACTIVE",
                    "tokens": 1
                }
            ],
            "when": "in [ atoi(valueof(\"in\")) == 1 ]",
            "do": "if (defined(\"set_to\")) { timeout = atoi(valueof(\"set_to\")); }"
        },
        {
            "transition_name": "T_off_start",
            "pos_x": 0,
            "pos_y": 0,
            "in_transition": [
                {
                    "place_name": "ACTIVE",
                    "tokens": 1
                }
            ],
            "out_transition": [
                {
                    "place_name": "TIMING",
                    "tokens": 1
                }
            ],
            "when": "in [ atoi(valueof(\"in\")) == 0 ]",
            "do": "if (defined(\"set_to\")) { timeout = atoi(valueof(\"set_to\")); }"
        },
        {
            "transition_name": "T_cancel_off",
            "pos_x": 0,
            "pos_y": 0,
            "in_transition": [
                {
                    "place_name": "TIMING",
                    "tokens": 1
                }
            ],
            "out_transition": [
                {
                    "place_name": "ACTIVE",
                    "tokens": 1
                }
            ],
            "when": "in [ atoi(valueof(\"in\")) == 1 ]",
            "do": "if (defined(\"set_to\")) { timeout = atoi(valueof(\"set_to\")); }"
        },
        {
            "transition_name": "T_timeout_off",
            "pos_x": 0,
            "pos_y": 0,
            "in_transition": [
                {
                    "place_name": "TIMING",
                    "tokens": 1
                }
            ],
            "out_transition": [
                {
                    "place_name": "IDLE",
                    "tokens": 1
                }
            ],
            "when": "@ timeout",
            "do": "if (defined(\"set_to\")) { timeout = atoi(valueof(\"set_to\")); }"
        },
        {
            "transition_name": "T_set_idle",
            "pos_x": 0,
            "pos_y": 0,
            "in_transition": [
                {
                    "place_name": "IDLE",
                    "tokens": 1
                }
            ],
            "out_transition": [
                {
                    "place_name": "IDLE",
                    "tokens": 1
                }
            ],
            "when": "set_to",
            "do": "timeout = atoi(valueof(\"set_to\")); output(\"rt\", 0);"
        },
        {
            "transition_name": "T_set_active",
            "pos_x": 0,
            "pos_y": 0,
            "in_transition": [
                {
                    "place_name": "ACTIVE",
                    "tokens": 1
                }
            ],
            "out_transition": [
                {
                    "place_name": "ACTIVE",
                    "tokens": 1
                }
            ],
            "when": "set_to",
            "do": "timeout = atoi(valueof(\"set_to\")); output(\"rt\", timeout);"
        },
        {
            "transition_name": "T_set_timing",
            "pos_x": 0,
            "pos_y": 0,
            "in_transition": [
                {
                    "place_name": "TIMING",
                    "tokens": 1
                }
            ],
            "out_transition": [
                {
                    "place_name": "TIMING",
                    "tokens": 1
                }
            ],
            "when": "set_to",
            "do": "timeout = atoi(valueof(\"set_to\")); output(\"rt\", timeout - elapsed(\"TIMING\"));"
        },
        {
            "transition_name": "T_req_idle",
            "pos_x": 0,
            "pos_y": 0,
            "in_transition": [
                {
                    "place_name": "IDLE",
                    "tokens": 1
                }
            ],
            "out_transition": [
                {
                    "place_name": "IDLE",
                    "tokens": 1
                }
            ],
            "when": "req_rt",
            "do": "output(\"rt\", 0);"
        },
        {
            "transition_name": "T_req_active",
            "pos_x": 0,
            "pos_y": 0,
            "in_transition": [
                {
                    "place_name": "ACTIVE",
                    "tokens": 1
                }
            ],
            "out_transition": [
                {
                    "place_name": "ACTIVE",
                    "tokens": 1
                }
            ],
            "when": "req_rt",
            "do": "output(\"rt\", timeout);"
        },
        {
            "transition_name": "T_req_active",
            "pos_x": 0,
            "pos_y": 0,
            "in_transition": [
                {
                    "place_name": "TIMING",
                    "tokens": 1
                }
            ],
            "out_transition": [
                {
                    "place_name": "TIMING",
                    "tokens": 1
                }
            ],
            "when": "req_rt",
            "do": "output(\"rt\", timeout - elapsed(\"TIMING\"));"
        }
    ]
}
